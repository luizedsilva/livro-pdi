      "boundElements": [],
      "updated": 1773861312708,
      "link": null,
      "locked": false,
      "text": "Para 0 <= x <= 2\n    y = round(2,5x + 0)\n\nPara 2 < x <= 4\n    y = round(0,5x + 4)\n\nPara 4 < x <= 7\n    y = round(0,3x + 4,7)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para 0 <= x <= 2\n    y = round(2,5x + 0)\n\nPara 2 < x <= 4\n    y = round(0,5x + 4)\n\nPara 4 < x <= 7\n    y = round(0,3x + 4,7)",
      "autoResize": true,
      "lineHeight": 1.25
    },
